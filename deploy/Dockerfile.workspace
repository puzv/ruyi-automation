FROM mcr.microsoft.com/playwright:v1.62.1-noble

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    NODE_ENV=production \
    RUYI_UPLOAD_DIR=/data/upload \
    RUYI_HEADLESS=1
WORKDIR /app
USER root
COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/server/package.json ./apps/server/
COPY apps/worker/package.json ./apps/worker/
COPY packages/automation/package.json ./packages/automation/
COPY packages/shared/package.json ./packages/shared/
# 前端构建需要开发依赖；五个工作区统一使用根锁文件安装。
RUN npm ci --include=dev
COPY . .
RUN npm run build:web \
    && mkdir -p /data/upload \
    && chown pwuser:pwuser /data/upload
USER pwuser
EXPOSE 5173
# 直接以 node 作为主进程：npm 收到 SIGTERM 会立即连同子进程一起退出，
# 应用来不及关闭 Worker 与登录浏览器；node 自己处理信号，按 main.js 的流程优雅停止。
ENTRYPOINT ["node", "apps/server/src/main.js"]
